{
  "name": "bsc-platform",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
